# secrets & sessions — never commit
.env
*.pickle
client_secrets.json
clippo_session.json
# session_import.py writes one storage_state per platform+account here. These
# ARE login credentials — a committed sessions/ file hands anyone with repo
# access the operator's TikTok/IG account.
sessions/

# runtime state & artifacts
*.sqlite
*.sqlite-*
media/
# Antrean + papan campaign: state runtime, dan `campaigns.db` nyimpen
# daftar aset yang jalurnya khas box ini. `*.db-wal`/`-shm` ikut, kalau
# enggak commit-nya bawa potongan transaksi.
*.db
*.db-wal
*.db-shm
# Aset yang DI-UPLOAD operator (BGM, gambar outro). Bukan sumber kode, dan
# ada yang berhak cipta -- jangan sampai kebawa ke repo.
assets/
*.words.json
*.heatmap.json
# ...but test fixtures are source, not runtime state. `media/` plus the global
# `*.words.json` rule meant the transcripts _v9/_v10 assert against could never
# be committed, so both tests died whenever the media cache was cleared and sat
# red for releases. 28K of JSON is cheaper than re-downloading a 79MB video and
# re-running whisper to recover a known-good fixture.
!tests/fixtures/
!tests/fixtures/*.words.json
jobs/
reports/
# Reference clips downloaded to compare a look against. Inputs to a judgement,
# not fixtures any test reads, so they stay out of the repo.
refs/
# render scratch — removed in a finally, but a killed render leaves it behind
temp_subs_*/
.job.lock
# learned transcript corrections: per-source runtime state, grows every render
glossary.json

__pycache__/
*.pyc
cookies.txt
smoke_*.mp4
out/
e2e_test.py
preflight_out.mp4
dash_*.png
dashboard.png
hookcuts/
